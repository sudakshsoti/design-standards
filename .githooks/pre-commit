#!/bin/sh
# Pre-commit guard: reject staged content that contains a protected brand or
# parent-org name. Zero dependencies — POSIX sh + git only, in keeping with the
# repo's no-tooling rule (this guards commits; it ships nothing to the site).
#
# The invariant it enforces: the committed tree never contains these terms.
# Always write "VC" instead.
#
# Bypass in a genuine emergency with:  git commit --no-verify
#
# The blocklist lives in this file, which is excluded from the scan below so the
# patterns don't trip the guard on themselves. Add terms to PATTERN with "|".

PATTERN='optum|value[ _-]?connect'

# Search staged (indexed) content only. Exemptions:
#  - .githooks: the pattern list here is exempt from its own rule.
#  - plans: internal, never-shipped planning docs must name the terms they scrub
#    (e.g. a re-palette plan documenting the move off a named brand colour).
#    The invariant that matters is that no *shippable* file carries the name.
matches=$(git grep --cached -n -iE "$PATTERN" -- ':!.githooks' ':!plans' 2>/dev/null)

if [ -n "$matches" ]; then
  echo "" >&2
  echo "✖ Commit blocked — a protected brand/parent-org name is in the staged tree:" >&2
  echo "" >&2
  echo "$matches" | sed 's/^/    /' >&2
  echo "" >&2
  echo "  Remove the term(s) above (write \"VC\" instead) and re-stage." >&2
  echo "  Genuine emergency override: git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# --- Maintainability review -------------------------------------------------
# Runs the maintainability-review skill (diff mode) over staged HTML/CSS via
# the `claude` CLI. Best-effort: skips cleanly if `claude` isn't installed,
# or if nothing HTML/CSS is staged, so it never blocks contributors who don't
# have it. Genuine emergency / false positive: git commit --no-verify

review_diff=$(git diff --cached --diff-filter=ACM -- '*.html' '*.css')

if [ -n "$review_diff" ] && command -v claude >/dev/null 2>&1; then
  echo "Running maintainability review on staged HTML/CSS..." >&2

  review_prompt="Use the maintainability-review skill in diff mode on the staged changes below, from this repo's static HTML/CSS design-records site (see AGENTS.md: no JS, no build step, token-driven CSS, shared record shell). Flag only real, concrete maintainability problems — DRY violations, drift from the repo's existing patterns, unclear structure. If there are none, reply with exactly: OK
Otherwise list each problem as a short plain line.

Staged diff:
$review_diff"

  review_output=$(claude -p "$review_prompt" --allowedTools "" 2>&1)
  review_status=$?

  if [ $review_status -eq 0 ] && ! echo "$review_output" | grep -qx "OK"; then
    echo "" >&2
    echo "✖ Maintainability review flagged issues in the staged changes:" >&2
    echo "" >&2
    echo "$review_output" | sed 's/^/    /' >&2
    echo "" >&2
    echo "  Fix them and re-stage, or override: git commit --no-verify" >&2
    exit 1
  fi
fi

exit 0
